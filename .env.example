# PostgreSQL (API only — never expose to the frontend)
# Local Postgres or Docker. Example Docker (recommended for this repo):
#   docker run -d --name nexus-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=nexus -p 5434:5432 postgres:16-alpine
# IMPORTANT: host port is 5434 (not 5432). API fallback matches this URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/nexus

# API integration tests only. Never point this at the UI database (`nexus`).
# `npm test` TRUNCATEs this database and inserts Acme/Northwind fixtures.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/nexus_test

# Session signing secret (API) — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-secret

# Optional secret for Express GET/PUT /hub/state (migrate/ops only). UI no longer uses this.
# Defaults to SESSION_SECRET if empty. Next /api/hub/* returns 410.
HUB_SYNC_SECRET=change-me-to-a-long-random-secret

# API server
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Frontend → API origin (Next rewrite /backend → this URL)
# Browser chama same-origin /backend/*; cookie de sessão fica em :3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Same origin for Next rewrites / server tooling (prefer this for rewrite target)
API_URL=http://localhost:4000

# Email — if RESEND_API_KEY is missing, emails are logged to the API console.
# Sandbox from onboarding@resend.dev only delivers to the Resend account email.
RESEND_API_KEY=
EMAIL_FROM=Avadesk <onboarding@resend.dev>

# Seed only (local demo) — INSERT/update admin@clienthub.dev; does not wipe tables
SEED_PASSWORD=Hub2026!

# AES-256-GCM key for project system credentials (NOT login passwords).
# Prefer 64 hex chars (32 bytes). Any passphrase is SHA-256'd in development.
CREDENTIALS_KEY=change-me-to-a-64-char-hex-or-long-passphrase

# Optional override for private file storage (default: apps/api/storage)
# STORAGE_DIR=

# Web Push (VAPID). Public key may also be NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Generate: npx web-push generate-vapid-keys
# Private key stays on the API only. iOS: PWA on the home screen (16.4+).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:avadesk@localhost
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
